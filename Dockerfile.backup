FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gosu \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl --fail --show-error --silent \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
        https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && printf '%s\n' \
        'Types: deb' \
        'URIs: https://apt.postgresql.org/pub/repos/apt' \
        'Suites: bookworm-pgdg' \
        'Components: main' \
        'Signed-By: /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc' \
        > /etc/apt/sources.list.d/pgdg.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-18 \
    && pg_dump --version | grep -Eq '^pg_dump \(PostgreSQL\) 18\.' \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
COPY scripts/backup_entrypoint.sh /usr/local/bin/backup-entrypoint

RUN useradd --create-home --uid 10001 amthero \
    && mkdir -p /backups \
    && chown -R amthero:amthero /app /backups \
    && chmod 0755 /usr/local/bin/backup-entrypoint

USER root

ENTRYPOINT ["/usr/local/bin/backup-entrypoint"]
CMD ["python", "-m", "scripts.postgres_backup"]
